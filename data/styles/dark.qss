QMainWindow,
QDialog {
    background-color: #0a0c10;
    color: #e6eef8;
    font-family: "Segoe UI";
    font-size: 12px;
}

QWidget {
    color: #e6eef8;
}

QToolBar {
    background-color: #10141c;
    border: none;
    border-bottom: 1px solid #202938;
    spacing: 7px;
    padding: 6px;
}

NavigationBar {
    background-color: #10141c;
    border-bottom: 1px solid #202938;
}

QLineEdit,
QComboBox,
QSpinBox {
    background-color: #111722;
    border: 1px solid #293446;
    border-radius: 9px;
    padding: 7px 10px;
    color: #e6eef8;
    selection-background-color: #4b93ff;
    selection-color: #ffffff;
}

QLineEdit {
    font-size: 12px;
}

QLineEdit#URLArea {
    background-color: #111722;
    border: 1px solid #293446;
    border-radius: 15px;
    padding: 7px 14px;
    color: #e6eef8;
}

QLineEdit#URLArea:focus,
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #4b93ff;
    background-color: #141d2a;
}

QPushButton {
    background-color: #111722;
    border: 1px solid #293446;
    border-radius: 9px;
    padding: 6px 11px;
    color: #d8e2f0;
}

QPushButton:hover {
    background-color: #19263a;
    border-color: #3e6da8;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1d3452;
    border-color: #4b93ff;
}

QPushButton:disabled {
    background-color: #11151c;
    border-color: #242b36;
    color: #6d7888;
}

QTabWidget::pane {
    background-color: #0e131b;
    border: 1px solid #202938;
    border-radius: 9px;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 15px;
    margin: 2px 4px 3px 0;
    color: #9aa8ba;
}

QTabBar::tab:selected {
    background-color: #152238;
    border-color: #233957;
    color: #a9cdff;
}

QTabBar::tab:hover:!selected {
    background-color: #141b26;
    color: #e6eef8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #111722;
    border: 1px solid #293446;
    selection-background-color: #192b44;
    selection-color: #a9cdff;
    outline: none;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 18px;
    border: none;
    background-color: transparent;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #46556a;
    border-radius: 5px;
    background-color: #111722;
}

QCheckBox::indicator:hover {
    border-color: #4b93ff;
}

QCheckBox::indicator:checked {
    background-color: #4b93ff;
    border-color: #4b93ff;
}

QGroupBox {
    margin-top: 12px;
    padding: 12px 10px 8px;
    border: 1px solid #202938;
    border-radius: 9px;
    color: #d8e2f0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #9aa8ba;
}

QProgressBar#progressBar {
    border: none;
    background-color: #171e29;
    border-radius: 3px;
    min-height: 5px;
    max-height: 5px;
    text-align: center;
    color: transparent;
}

QProgressBar#progressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #ff8c00, stop: 1 #4b93ff);
    border-radius: 3px;
}

QStatusBar {
    background-color: #10141c;
    border-top: 1px solid #202938;
    color: #9aa8ba;
}

QMenuBar {
    background-color: #10141c;
    border-bottom: 1px solid #202938;
    color: #d8e2f0;
}

QMenuBar::item {
    padding: 5px 8px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: #19263a;
    color: #a9cdff;
}

QMenu {
    background-color: #111722;
    border: 1px solid #293446;
    padding: 4px;
    color: #d8e2f0;
}

QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #19263a;
    color: #a9cdff;
}

QDialog#SettingsDialog {
    background-color: rgba(0, 0, 0, 175);
}

QWidget#settings_card {
    background-color: #10141c;
    border: 1px solid #202938;
    border-radius: 14px;
}

QScrollBar:vertical {
    width: 10px;
    margin: 2px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 24px;
    border-radius: 4px;
    background: #374458;
}

QScrollBar::handle:vertical:hover {
    background: #4a5b73;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}